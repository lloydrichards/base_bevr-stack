{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "PORT",
        "HOST",
        "IDLE_TIMEOUT",
        "ALLOWED_ORIGINS",
        "MCP_PORT",
        "DEVTOOLS",
        "LOG_LEVEL",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "VITE_*"
      ]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"],
      "passThroughEnv": ["CI"]
    },
    "clean": {
      "cache": false
    },
    "//#format": {},
    "//#lint": {
      "cache": false
    }
  },
  "globalDependencies": [".env*", "tsconfig.json", "biome.jsonc"]
}
