# Copy to .env at the repository root for bun run commands and Docker Compose.
# The API reads the key at startup. Use a real key to enable chat.
ANTHROPIC_API_KEY=

# Local server and MCP runtime settings
PORT=9000
HOST=0.0.0.0
MCP_PORT=9009
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=Info
DEVTOOLS=false

# Browser URLs are public and embedded in production builds. Never put secrets here.
VITE_SERVER_URL=http://localhost:9000
VITE_WS_URL=ws://localhost:9000/ws
VITE_ENABLE_DEVTOOLS=false

# Docker host ports. Containers listen on 9000, 9009, and 80 respectively.
SERVER_PORT=9000
CLIENT_PORT=3000

# Optional OTLP/HTTP tracing. Set both values to enable it outside Compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=bevr-server
